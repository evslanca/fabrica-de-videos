import { LedState } from "../../primitives/status-led.slint";

// Cubic Bezier wire renderer for connecting node output ports to input ports,
// inspired by n8n's workflow canvas.

export struct FactoryNodeRow {
    id: string,
    title: string,
    subtitle: string,
    status: LedState,
    progress: float,
    pos-x: length,
    pos-y: length,
}

export struct WireConnection {
    from-idx: int,
    to-idx: int,
    active: bool,
}

export component WireLayer inherits Rectangle {
    in property <[WireConnection]> wires;
    in property <[FactoryNodeRow]> nodes;
    in property <string> selected-node-id: "";
    in property <length> origin-x: 0px;
    in property <length> origin-y: 0px;
    in property <float> zoom: 1.0;
    in property <length> card-width: 220px;
    in property <length> port-y-offset: 45px;

    property <bool> has-selection: root.selected-node-id != "";
    property <float> flow-t: root.has-selection ? Math.mod(animation-tick() / 1s * 0.75, 1.0) : 0.0;
    property <float> pulse: root.has-selection ? 0.5 + 0.5 * Math.sin(animation-tick() / 1s * 4.0 * 1rad) : 0.0;

    background: transparent;

    for w in root.wires : Rectangle {
        property <float> sx: ((root.nodes[w.from-idx].pos-x * root.zoom + root.origin-x + root.card-width) / 1px);
        property <float> sy: ((root.nodes[w.from-idx].pos-y * root.zoom + root.origin-y + root.port-y-offset) / 1px);
        property <float> ex: ((root.nodes[w.to-idx].pos-x * root.zoom + root.origin-x) / 1px);
        property <float> ey: ((root.nodes[w.to-idx].pos-y * root.zoom + root.origin-y + root.port-y-offset) / 1px);
        property <float> dx: Math.max(40.0, Math.abs(ex - sx) * 0.5);
        property <float> c1x: sx + dx;
        property <float> c2x: ex - dx;

        property <bool> is-incoming: root.has-selection && root.nodes[w.to-idx].id == root.selected-node-id;
        property <bool> is-outgoing: root.has-selection && root.nodes[w.from-idx].id == root.selected-node-id;
        property <bool> is-connected: is-incoming || is-outgoing;

        // Incoming wires ("de onde vem") glow amber/cyan; outgoing wires ("para onde vai") glow sky-blue/emerald.
        property <color> wire-color: is-incoming ? #f59e0b
            : is-outgoing ? #38bdf8
            : w.active ? #3b82f6
            : #3f3f52;

        width: 100%;
        height: 100%;
        background: transparent;
        opacity: (!root.has-selection || is-connected) ? 1.0 : 0.35;

        // Soft outer glow when connected to the selected node
        if is-connected : Path {
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: Math.max(1.0, root.width / 1px);
            viewbox-height: Math.max(1.0, root.height / 1px);
            width: 100%;
            height: 100%;

            stroke: wire-color.with-alpha(0.22 + 0.16 * root.pulse);
            stroke-width: 7px;
            fill: transparent;

            MoveTo { x: sx; y: sy; }
            CubicTo {
                control-1-x: c1x; control-1-y: sy;
                control-2-x: c2x; control-2-y: ey;
                x: ex; y: ey;
            }
        }

        // Main Bezier wire
        Path {
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: Math.max(1.0, root.width / 1px);
            viewbox-height: Math.max(1.0, root.height / 1px);
            width: 100%;
            height: 100%;

            stroke: wire-color;
            stroke-width: is-connected ? 3px : (w.active ? 2.5px : 1.8px);
            fill: transparent;

            MoveTo { x: sx; y: sy; }
            CubicTo {
                control-1-x: c1x; control-1-y: sy;
                control-2-x: c2x; control-2-y: ey;
                x: ex; y: ey;
            }
        }

        // Animated flow particles travelling along the Bezier curve from source -> target
        if is-connected : Rectangle {
            width: 100%;
            height: 100%;
            background: transparent;

            for offset in [0.0, 0.333, 0.666] : Rectangle {
                property <float> t: Math.mod(root.flow-t + offset, 1.0);
                property <float> u: 1.0 - t;
                property <float> bx: u*u*u * sx + 3.0*u*u*t * c1x + 3.0*u*t*t * c2x + t*t*t * ex;
                property <float> by: u*u*u * sy + 3.0*u*u*t * sy  + 3.0*u*t*t * ey  + t*t*t * ey;

                x: bx * 1px - self.width / 2;
                y: by * 1px - self.height / 2;
                width: 9px;
                height: 9px;
                border-radius: 4.5px;
                background: #ffffff;
                border-width: 2px;
                border-color: wire-color;
            }

            // Source port highlight ring
            Rectangle {
                x: sx * 1px - 6px;
                y: sy * 1px - 6px;
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: wire-color.with-alpha(0.35 + 0.35 * root.pulse);
                border-width: 1.5px;
                border-color: wire-color;
            }

            // Target port highlight ring
            Rectangle {
                x: ex * 1px - 6px;
                y: ey * 1px - 6px;
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: wire-color.with-alpha(0.35 + 0.35 * root.pulse);
                border-width: 1.5px;
                border-color: wire-color;
            }
        }
    }
}
