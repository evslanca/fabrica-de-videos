import { Theme } from "../theme/theme.slint";
import { StatusLed, LedState, LevelMeter } from "../primitives/primitives.slint";
import { FactoryNodeCard } from "./factory/node-card.slint";
import { BatchQueuePanel, BatchQueueItem } from "./factory/batch-queue.slint";
import { NodeInspector } from "./factory/node-inspector.slint";
import { WireLayer, WireConnection } from "./factory/wire-renderer.slint";

// Factory Pane: the visual workflow canvas.
// Renders a dark dotted-grid infinite canvas with pan/zoom, draggable node cards
// connected by cubic bezier wires, status LEDs, stereo VU meters, and batch queue.

export struct FactoryNodeRow {
    id: string,
    title: string,
    subtitle: string,
    status: LedState,
    progress: float,
    pos-x: length,
    pos-y: length,
}

export global FactoryData {
    // Pipeline nodes to render on the canvas
    in-out property <[FactoryNodeRow]> nodes: [
        { id: "script",  title: "Roteiro",       subtitle: "Divisão em cenas e hook",           status: LedState.Off, progress: 0.0, pos-x: 30px,  pos-y: 120px },
        { id: "voice",   title: "Voz / TTS",     subtitle: "Edge-TTS · Chatterbox · Cloning",   status: LedState.Off, progress: 0.0, pos-x: 300px, pos-y: 30px  },
        { id: "media",   title: "B-Roll",        subtitle: "Pexels · Pixabay · Ken Burns",      status: LedState.Off, progress: 0.0, pos-x: 300px, pos-y: 150px },
        { id: "music",   title: "Música IA",     subtitle: "Sem Voz (BGM) · Com Voz (Letra)",   status: LedState.Off, progress: 0.0, pos-x: 300px, pos-y: 270px },
        { id: "sfx",     title: "SFX & Áudio",   subtitle: "Whoosh · Riser · Auto-Ducking",     status: LedState.Off, progress: 0.0, pos-x: 570px, pos-y: 60px  },
        { id: "caption", title: "Legendas",      subtitle: "Hormozi · Safe Zone · Palavras",    status: LedState.Off, progress: 0.0, pos-x: 570px, pos-y: 200px },
        { id: "export",  title: "Exportar",      subtitle: "16:9 YouTube · 9:16 Shorts",        status: LedState.Off, progress: 0.0, pos-x: 840px, pos-y: 130px },
    ];

    // Cubic bezier wire connections between node output and input ports
    in-out property <[WireConnection]> wires: [
        // script (250, 165) -> voice (300, 75)
        { start-x: 250.0, start-y: 165.0, end-x: 300.0, end-y: 75.0,  active: true  },
        // script (250, 165) -> media (300, 195)
        { start-x: 250.0, start-y: 165.0, end-x: 300.0, end-y: 195.0, active: true  },
        // script (250, 165) -> music (300, 315)
        { start-x: 250.0, start-y: 165.0, end-x: 300.0, end-y: 315.0, active: true  },
        // voice (520, 75) -> sfx (570, 105)
        { start-x: 520.0, start-y: 75.0,  end-x: 570.0, end-y: 105.0, active: true  },
        // music (520, 315) -> sfx (570, 105)
        { start-x: 520.0, start-y: 315.0, end-x: 570.0, end-y: 105.0, active: true  },
        // voice (520, 75) -> caption (570, 245)
        { start-x: 520.0, start-y: 75.0,  end-x: 570.0, end-y: 245.0, active: false },
        // media (520, 195) -> export (840, 175)
        { start-x: 520.0, start-y: 195.0, end-x: 840.0, end-y: 175.0, active: true  },
        // sfx (790, 105) -> export (840, 175)
        { start-x: 790.0, start-y: 105.0, end-x: 840.0, end-y: 175.0, active: false },
        // caption (790, 245) -> export (840, 175)
        { start-x: 790.0, start-y: 245.0, end-x: 840.0, end-y: 175.0, active: false },
    ];

    in-out property <[BatchQueueItem]> batch-items;
    in-out property <bool>     batch-running: false;
    in-out property <int>      batch-completed: 0;
    in-out property <int>      batch-total: 0;
    in-out property <string>   selected-node-id: "";
    in-out property <string>   selected-node-kind: "";
    in-out property <string>   selected-node-title: "";
    in-out property <LedState> selected-node-status: LedState.Off;
    in-out property <bool>     aspect-16-9: true;
    in-out property <float>    vu-left: 0.0;
    in-out property <float>    vu-right: 0.0;

    callback fabricate();
    callback node-selected(string, string);  // id, kind
    callback aspect-changed(bool);           // true = 16:9, false = 9:16
    callback start-batch();
    callback stop-batch();
    callback test-node(string);
}

export component FactoryPane {
    property <length> pan-x: 0px;
    property <length> pan-y: 0px;
    property <float>  zoom: 1.0;

    HorizontalLayout {
        spacing: 0px;

        // ── Main canvas area ───────────────────────────────────────────────
        Rectangle {
            horizontal-stretch: 1;
            background: #0d0d12;
            clip: true;

            // Pan gesture on canvas background
            TouchArea {
                property <length> drag-start-x;
                property <length> drag-start-y;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        drag-start-x = self.mouse-x - root.pan-x;
                        drag-start-y = self.mouse-y - root.pan-y;
                    }
                }
                moved => {
                    if (self.pressed) {
                        root.pan-x = self.mouse-x - drag-start-x;
                        root.pan-y = self.mouse-y - drag-start-y;
                    }
                }
            }

            // CUBIC BEZIER WIRES
            WireLayer {
                width: 100%;
                height: 100%;
                wires: FactoryData.wires;
                origin-x: root.pan-x;
                origin-y: root.pan-y;
                zoom: root.zoom;
            }

            // NODE CARDS (positioned on canvas with pan & zoom + drag)
            for node[idx] in FactoryData.nodes : FactoryNodeCard {
                x: node.pos-x * root.zoom + root.pan-x;
                y: node.pos-y * root.zoom + root.pan-y;
                title: node.title;
                subtitle: node.subtitle;
                status: node.status;
                progress: node.progress;
                selected: FactoryData.selected-node-id == node.id;

                run-pressed  => { FactoryData.test-node(node.id); }
                card-clicked => { FactoryData.node-selected(node.id, node.id); }
                moved(dx, dy) => {
                    FactoryData.nodes[idx].pos-x = node.pos-x + dx / root.zoom;
                    FactoryData.nodes[idx].pos-y = node.pos-y + dy / root.zoom;
                }
            }

            // ── Top-right zoom controls ────────────────────────────────────
            Rectangle {
                x: parent.width - self.width - 12px;
                y: 12px;
                width: 112px;
                height: 30px;
                border-radius: 6px;
                background: #14141b.with-alpha(0.9);
                border-width: 1px;
                border-color: #2a2a35;

                HorizontalLayout {
                    padding: 4px;
                    spacing: 4px;
                    alignment: center;

                    Rectangle {
                        width: 24px; height: 22px; border-radius: 4px; background: #1e1e28;
                        Text { text: "-"; color: #cbd5e1; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.zoom = Math.max(0.5, root.zoom - 0.1); } }
                    }

                    Text {
                        text: Math.round(root.zoom * 100) + "%";
                        color: #94a3b8;
                        font-size: 10px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        width: 34px;
                    }

                    Rectangle {
                        width: 24px; height: 22px; border-radius: 4px; background: #1e1e28;
                        Text { text: "+"; color: #cbd5e1; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.zoom = Math.min(1.6, root.zoom + 0.1); } }
                    }

                    Rectangle {
                        width: 18px; height: 22px; border-radius: 4px; background: #1e1e28;
                        Text { text: "⟲"; color: #94a3b8; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.zoom = 1.0; root.pan-x = 0px; root.pan-y = 0px; } }
                    }
                }
            }

            // ── Bottom action bar ─────────────────────────────────────────
            Rectangle {
                y: parent.height - self.height;
                height: 52px;
                width: 100%;
                background: #111116.with-alpha(0.95);
                border-width: 1px;
                border-color: #2a2a35;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 12px;
                    alignment: space-between;

                    // Format toggle: 16:9 / 9:16
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: center;

                        Text {
                            text: "Formato:";
                            font-size: 11px;
                            color: #6b7280;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 60px; height: 28px;
                            border-radius: 6px;
                            background: FactoryData.aspect-16-9 ? #1d4ed8 : #1a1a1f;
                            border-width: 1px;
                            border-color: FactoryData.aspect-16-9 ? #3b82f6 : #333340;

                            Text {
                                text: "16:9";
                                font-size: 11px;
                                font-weight: FactoryData.aspect-16-9 ? 700 : 400;
                                color: FactoryData.aspect-16-9 ? #bfdbfe : #9ca3af;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => {
                                    FactoryData.aspect-16-9 = true;
                                    FactoryData.aspect-changed(true);
                                }
                            }
                        }

                        Rectangle {
                            width: 60px; height: 28px;
                            border-radius: 6px;
                            background: !FactoryData.aspect-16-9 ? #1d4ed8 : #1a1a1f;
                            border-width: 1px;
                            border-color: !FactoryData.aspect-16-9 ? #3b82f6 : #333340;

                            Text {
                                text: "9:16";
                                font-size: 11px;
                                font-weight: !FactoryData.aspect-16-9 ? 700 : 400;
                                color: !FactoryData.aspect-16-9 ? #bfdbfe : #9ca3af;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => {
                                    FactoryData.aspect-16-9 = false;
                                    FactoryData.aspect-changed(false);
                                }
                            }
                        }
                    }

                    // Stereo VU meter strip + clipping warning LEDs (+0 dB red)
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: center;

                        VerticalLayout {
                            width: 140px;
                            alignment: center;
                            spacing: 3px;

                            LevelMeter { value: FactoryData.vu-left;  thickness: 4px; }
                            LevelMeter { value: FactoryData.vu-right; thickness: 4px; }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;

                            StatusLed {
                                state: FactoryData.vu-left >= 0.99 ? LedState.Error : LedState.Off;
                                size: 7px;
                            }
                            StatusLed {
                                state: FactoryData.vu-right >= 0.99 ? LedState.Error : LedState.Off;
                                size: 7px;
                            }
                        }
                    }

                    // FABRICATE master button
                    Rectangle {
                        width: 180px; height: 36px;
                        border-radius: 8px;
                        background: @linear-gradient(135deg, #7c3aed, #2563eb);
                        border-width: 1px;
                        border-color: #818cf8;

                        Text {
                            text: "⚡ FABRICAR VÍDEO";
                            font-size: 13px;
                            font-weight: 900;
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            clicked => { FactoryData.fabricate(); }
                        }
                    }
                }
            }
        }

        // ── Right sidebar: Inspector + Batch Queue ─────────────────────────
        VerticalLayout {
            width: 272px;
            spacing: 8px;
            padding: 8px;
            background: #0d0d12;

            NodeInspector {
                node-kind: FactoryData.selected-node-kind;
                node-title: FactoryData.selected-node-title != "" ? FactoryData.selected-node-title : "Nenhum Nó Selecionado";
                node-status: FactoryData.selected-node-status;
                apply => {}
                test-node => { FactoryData.test-node(FactoryData.selected-node-id); }
            }

            BatchQueuePanel {
                items: FactoryData.batch-items;
                running: FactoryData.batch-running;
                completed-count: FactoryData.batch-completed;
                total-count: FactoryData.batch-total;
                start-batch => { FactoryData.start-batch(); }
                stop-batch  => { FactoryData.stop-batch(); }
                clear-queue => { FactoryData.batch-items = []; }
            }
        }
    }
}
